# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql+asyncpg://sonicvault:CHANGE_ME@localhost:5432/sonicvault

# Semicolon-separated folders to index (forward slashes work on Windows)
MEDIA_ROOTS=C:/Users/you/Music;C:/Users/you/Videos/MusicVideos

# Where extracted album art and downloaded streams are stored
COVER_CACHE_DIR=./data/covers
DOWNLOAD_DIR=./data/downloads

# yt-dlp
YTDLP_STREAM_TTL_SECONDS=18000
FFMPEG_LOCATION=
# JS runtime yt-dlp uses for YouTube challenges (node or deno)
YTDLP_JS_RUNTIME=node
# Fast YouTube client + player variant (see backend/app/config.py). Blank = yt-dlp defaults.
YTDLP_PLAYER_CLIENTS=tv_embedded
YTDLP_PLAYER_JS_VARIANT=actual
# Optional Netscape cookies.txt for age-restricted videos
YTDLP_COOKIES_FILE=

# Server
HOST=127.0.0.1
PORT=8000
# Incremental library scan every time the server starts
SCAN_ON_STARTUP=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Hosting (see DEPLOY.md). Leave APP_PASSWORD empty for password-free local use.
APP_PASSWORD=
SECRET_KEY=
# Create / upgrade the database tables automatically at startup
AUTO_MIGRATE=false
